{
  "name": "foundryvtt-mediasoup-webrtc",
  "version": "0.7.20",
  "description": "WebRTC audio/video communication module for FoundryVTT using MediaSoup SFU server",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/e2e/sfu/tsconfig.json && tsc --noEmit -p tests/e2e/foundry/tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:e2e:report": "playwright show-report test-results/playwright-report",
    "test:server": "cd server && cargo test",
    "build:server": "cd server && cargo build --release",
    "check": "bun run typecheck && bun run build && bun run lint && bun run test"
  },
  "keywords": [
    "foundryvtt",
    "foundry-vtt",
    "module",
    "webrtc",
    "mediasoup",
    "audio",
    "video",
    "communication",
    "tabletop",
    "rpg"
  ],
  "author": "Lauri Gates",
  "license": "MIT",
  "dependencies": {
    "mediasoup-client": "3.24.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "fake-mediastreamtrack": "2.2.1",
    "happy-dom": "20.14.5",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laurigates/foundryvtt-mediasoup-webrtc.git"
  },
  "bugs": {
    "url": "https://github.com/laurigates/foundryvtt-mediasoup-webrtc/issues"
  },
  "homepage": "https://github.com/laurigates/foundryvtt-mediasoup-webrtc#readme"
}

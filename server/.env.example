# MediaSoup SFU configuration. Every variable the server reads is listed here;
# see README.md for details. Commented lines show the default.
# The binary does not load this file itself: export it (`set -a; . ./.env`),
# use it as a systemd EnvironmentFile, or pass it to docker compose.

# WebSocket signaling address.
MEDIASOUP_LISTEN_ADDR=0.0.0.0:3000

# Parsed but currently unused.
# MEDIASOUP_HTTP_ADDR=0.0.0.0:8080

# Number of mediasoup worker processes (at least 1). Rooms are spread over
# them round-robin.
MEDIASOUP_NUM_WORKERS=1

# Worker log level: debug, warn, error, none.
MEDIASOUP_LOG_LEVEL=warn

# Worker log tags, comma-separated (info, ice, dtls, rtp, srtp, rtcp, rtx,
# bwe, score, simulcast, svc, sctp, message).
MEDIASOUP_LOG_TAGS=info

# ICE/RTP port range, used for both UDP and TCP. About two ports per client
# per protocol.
MEDIASOUP_RTC_MIN_PORT=10000
MEDIASOUP_RTC_MAX_PORT=10100

# IP the WebRTC sockets bind to: 0.0.0.0 / :: (all interfaces) or a concrete
# interface address.
# MEDIASOUP_LISTEN_IP=0.0.0.0

# Address put into ICE candidates: the public IP or DNS name clients reach
# this host on. REQUIRED when MEDIASOUP_LISTEN_IP is 0.0.0.0 or :: (the
# default); the server refuses to start without it. Empty counts as unset.
MEDIASOUP_ANNOUNCED_IP=192.0.2.10

# Start with a wildcard listen IP and no announced IP anyway (logs a warning
# instead of failing). Local testing only.
# MEDIASOUP_ALLOW_UNANNOUNCED=0

# ICE protocols (1/0). At least one must be on. TCP is the fallback for
# networks that block UDP.
# MEDIASOUP_ENABLE_UDP=1
# MEDIASOUP_ENABLE_TCP=1
# MEDIASOUP_PREFER_UDP=1

# Shared secret clients send in `authenticate`. Unset or empty means NO
# authentication (a warning is logged). Use the same value in the module's
# "MediaSoup Server Auth Token" setting.
# MEDIASOUP_AUTH_TOKEN=change-me

# Native TLS (wss://). Enabled only when both are set; otherwise the server
# serves plain ws:// and TLS belongs on a reverse proxy.
# MEDIASOUP_TLS_CERT=/path/to/fullchain.pem
# MEDIASOUP_TLS_KEY=/path/to/privkey.pem
